# RIOT modules
USEMODULE += event
USEMODULE += periph_gpio_irq
USEMODULE += motor_driver
USEMODULE += printf_float
USEMODULE += ps
USEMODULE += scanf_float
USEMODULE += schedstatistics
USEMODULE += shell
USEMODULE += shell_cmds_default

# mcu-firmware modules
USEMODULE += cogip_defs
USEMODULE += localization
USEMODULE += path
USEMODULE += pf-common
USEMODULE += encoder
USEMODULE += motor
USEMODULE += parameter
USEMODULE += parameter_handler
USEMODULE += telemetry
USEMODULE += utils

# Controllers
USEMODULE += reset_controller
USEMODULE += acceleration_filter
USEMODULE += anti_blocking_controller
USEMODULE += conditional_switch_meta_controller
USEMODULE += deceleration_filter
USEMODULE += tracker_combiner_controller
USEMODULE += passthrough_pose_pid_controller
USEMODULE += path_manager_filter
USEMODULE += speed_limit_filter
USEMODULE += pose_pid_controller
USEMODULE += profile_tracker_controller
USEMODULE += quadpid_meta_controller
USEMODULE += platform_engine
USEMODULE += pose_straight_filter
USEMODULE += speed_filter
USEMODULE += target_change_detector
USEMODULE += telemetry_controller

# Ethernet firmware update over TFTP into the inactive riotboot slot. Only
# pulled in on boards that provide Ethernet; the flashwrite targets the other
# slot, so this is only meaningful in a riotboot build.
ifneq (,$(filter periph_eth,$(FEATURES_PROVIDED)))
  FEATURES_REQUIRED += riotboot
  USEMODULE += fw_update_tftp
  USEMODULE += lwip lwip_ipv4 lwip_arp lwip_udp lwip_app_tftp
  USEMODULE += ipv4_addr
  USEMODULE += netdev_default
  USEMODULE += riotboot_flashwrite
  USEMODULE += riotboot_slot
  # Tee the whole console to a syslog collector over the network (RFC 5424),
  # keeping the local console. log_syslog adds per-severity tagging and pulls
  # in the stdio_syslog backend that does the forwarding.
  # Server address defaults to the gateway; override with NET_SYSLOG_IP=<ip>.
  NET_SYSLOG_IP ?= 192.168.0.1
  USEMODULE += log_syslog
  CFLAGS += -DCONFIG_SYSLOG_SERVER=\"$(NET_SYSLOG_IP)\"
  CFLAGS += -DCONFIG_SYSLOG_HOSTNAME=\"robot$(ROBOT_ID)\"
  # CONFIG_SYSLOG_APPNAME is set per application (defaults to $(APPLICATION)),
  # so each firmware tags its own syslog identifier (journalctl -t <app>).
  # Queue packets while the syslog server's MAC is being ARP-resolved instead
  # of dropping them (lwIP default ARP_QUEUEING=0 keeps only the one packet
  # that triggers the request, losing the leading burst of the boot dump).
  CFLAGS += -DARP_QUEUEING=1
  CFLAGS += -DARP_QUEUE_LEN=16
endif

# Board features required
FEATURES_REQUIRED += periph_pwm

# OTOS localization support for robots using optical tracking
ifneq (,$(filter 2,$(ROBOT_ID)))
  USEMODULE += localization_otos
else
  FEATURES_REQUIRED += periph_qdec
endif
